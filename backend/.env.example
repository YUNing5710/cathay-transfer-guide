# 复制本文件为 .env，并填入你自己的 OAG Subscription Key（不要上传 GitHub）
OAG_KEY=YOUR_SUBSCRIPTION_KEY
PORT=8787

# Connections API
OAG_CONN_KEY=YOUR_CONNECTIONS_KEY
OAG_CONN_URL=https://api.oag.com/flight-connections/
# Master Data API
OAG_MASTER_KEY=YOUR_MASTER_DATA_KEY
OAG_MASTER_URL=从OAG文档复制请求地址

# Vera 聊天：阿里云百炼 Qwen（OpenAI 兼容接口）。换 Groq / OpenRouter / 本地 Ollama 只要改这三行
LLM_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_KEY=YOUR_QWEN_KEY
LLM_MODEL=qwen-plus
